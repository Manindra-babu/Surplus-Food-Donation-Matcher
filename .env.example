# ==========================================
# FoodBridge AI Environment Configuration
# ==========================================

# Google Gemini API Key (optional, deterministic fallback active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default 8000)
PORT=8000

# Product Branding
PRODUCT_NAME=FoodBridge AI

# Frontend API URL (leave blank if deploying unified Docker / single server)
# Only required if deploying frontend to Vercel/Netlify separately:
# VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
